        <jsScript_script>//Script here
// Count missing operational fields
missing_fields_count = 0;

if (defects == null) {
    missing_fields_count++;
}

if (maintenance_hours == null) {
    missing_fields_count++;
}

if (downtime_hours == null) {
    missing_fields_count++;
}

if (rework_hours == null) {
    missing_fields_count++;
}


// Assign data quality flag
if (missing_fields_count == 0) {
    data_quality_flag = "GOOD";
} else {
    data_quality_flag = "WARNING";
}
</jsScript_script>
